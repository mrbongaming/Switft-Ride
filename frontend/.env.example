# Public URL of the Spring Cloud Gateway. Leave empty to use Vite's /api proxy.
VITE_API_BASE_URL=/api
# Used by the Vite dev proxy only. Do not put secrets here.
GATEWAY_TARGET=http://localhost:8080
# Public map services used only for address lookup and route preview.
# Keep these configurable so production can switch to a hosted or self-hosted provider.
VITE_GEOCODING_URL=https://nominatim.openstreetmap.org
VITE_ROUTING_URL=https://router.project-osrm.org
